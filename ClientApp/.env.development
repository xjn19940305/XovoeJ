# App settings panel
VITE_APP_SETTING=false
# Page title
VITE_APP_TITLE=XovoeJ
# API base URL, used as axios baseURL
VITE_APP_API_BASEURL=https://localhost:7216
# Debug tool: eruda or vconsole
VITE_APP_DEBUG_TOOL=
# Disable devtools
VITE_APP_DISABLE_DEVTOOL=false

# Enable proxy in development
VITE_OPEN_PROXY=false
# Enable Vue devtools
VITE_OPEN_DEVTOOLS=false
